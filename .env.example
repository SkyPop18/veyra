# ============================================================================
# VEYRA — Environment Configuration Template (Placeholders Only — NO Secrets!)
# Copy real values into .env.local (gitignored) or AI Studio Settings > Secrets.
# ============================================================================

# Gemini AI (Server-only — never prefix with VITE_)
GEMINI_API_KEY=

# Application URL
APP_URL=https://veyra-global.vercel.app

# Supabase Project (Public URL & Anon Key are browser-safe; Service Role is SERVER-ONLY)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Legal Consent Version (bump to re-prompt all users via /accept-terms gate)
VITE_TERMS_VERSION=2026-11

# External Market & News APIs (Server-only — optional; open fallback + cache active)
COINGECKO_API_KEY=
EXCHANGERATE_API_KEY=
GNEWS_API_KEY=

# Cron Refresh Protection (Server-only)
CRON_SECRET=

# Discord Integration & Bot (Server-only secrets; use least-privilege invite permissions=2147502080)
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
VITE_DISCORD_INVITE_URL=

# Hidden Admin Console (Server-only — NEVER expose path or secrets to client bundles)
# Set an unguessable 24+ char path (e.g. /vx-3f9a7c1e0d9b4e2a8c1f6d30)
ADMIN_BASE_PATH=
# Comma-separated allowlist of Supabase admin emails (must also have profiles.is_admin=true + TOTP MFA aal2)
ADMIN_EMAILS=
# Optional comma-separated IP allowlist for admin routes
ADMIN_ALLOWED_IPS=
# Optional HMAC signing secret for server-side auxiliary tokens (auto-generated in memory if omitted)
ADMIN_SESSION_SECRET=